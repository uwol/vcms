#
# Known PHPStan findings that are deliberately not reported.
#
# Every entry is the same case: `$stmt->bindColumn('column', $var)` assigns $var by
# reference. PHPStan does not see this because $stmt comes from $libDb->prepare() and
# $libDb is a global variable whose type PHPStan cannot know project-wide. The code
# works; these are not real defects.
#
# Do not edit this file by hand. Regenerate it with:
#   bin/analyse --generate-baseline=phpstan-baseline.neon
# It should shrink over time, not grow.
#
parameters:
	ignoreErrors:
		-
			message: '#^Undefined variable\: \$number$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/lib/LibAssociation.class.php

		-
			message: '#^Undefined variable\: \$internetwart$#'
			identifier: variable.undefined
			count: 3
			path: vendor/vcms/lib/LibAuth.class.php

		-
			message: '#^Undefined variable\: \$lastMistakenLoginToday$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/lib/LibAuth.class.php

		-
			message: '#^Undefined variable\: \$numberOfMistakenLoginsToday$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/lib/LibAuth.class.php

		-
			message: '#^Undefined variable\: \$numberOfCronJobExecutionsToday$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/lib/LibCronjobs.class.php

		-
			message: '#^Undefined variable\: \$title$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/lib/LibEvent.class.php

		-
			message: '#^Undefined variable\: \$count$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/lib/LibForm.class.php

		-
			message: '#^Undefined variable\: \$count$#'
			identifier: variable.undefined
			count: 4
			path: vendor/vcms/lib/LibGenericStorage.class.php

		-
			message: '#^Undefined variable\: \$value$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/lib/LibGenericStorage.class.php

		-
			message: '#^Undefined variable\: \$fullPoints$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/lib/LibPerson.class.php

		-
			message: '#^Undefined variable\: \$group$#'
			identifier: variable.undefined
			count: 3
			path: vendor/vcms/lib/LibPerson.class.php

		-
			message: '#^Undefined variable\: \$pointsAddedToday$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/lib/LibPerson.class.php

		-
			message: '#^Undefined variable\: \$isRegistered$#'
			identifier: variable.undefined
			count: 3
			path: vendor/vcms/modules/base_internet_event/scripts/event.php

		-
			message: '#^Undefined variable\: \$chargierCount$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/modules/base_intranet_personen/scripts/person.php

		-
			message: '#^Undefined variable\: \$description$#'
			identifier: variable.undefined
			count: 2
			path: vendor/vcms/modules/base_intranet_personen/scripts/person.php
