# Normalize all text files to LF in the repository and in the working tree
* text=auto eol=lf

# Explicit text types
*.php     text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.svg     text eol=lf
*.map     text eol=lf

# Binary files: never touch
*.jpg     binary
*.png     binary
*.gif     binary
*.ico     binary
*.otf     binary
*.ttf     binary
*.eot     binary
*.woff    binary
*.woff2   binary
*.zip     binary
*.pdf     binary
